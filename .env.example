# Server Configuration
PORT=3000
NODE_ENV=development

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_URL=https://your-domain.com/telegram

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/telegram-bot-builder

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Credits System
FREE_CREDITS=10
CREDIT_COST_PER_REQUEST=1

# Referral System
REFERRAL_BONUS=5
REFERRAL_EARNING=2

# Telegram Login Widget
TELEGRAM_LOGIN_URL=https://t.me/your-bot
TELEGRAM_LOGIN_BOT_NAME=your_bot_name

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000

# CORS
CORS_ORIGIN=http://localhost:3000

# Payment (if using external payment gateway)
PAYMENT_API_KEY=
PAYMENT_API_URL=